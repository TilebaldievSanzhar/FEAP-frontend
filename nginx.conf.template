server {
    listen 80;
    server_name _;
    root /usr/share/nginx/html;
    index index.html;

    # Generous for OCR uploads (matches VITE_OCR_MAX_FILE_MB default of 25 MB, plus headroom).
    client_max_body_size 50m;

    # Docker's embedded DNS. Re-resolving upstream on every request means a
    # backend-container restart (new IP inside the bridge network) doesn't leave
    # nginx stuck on a stale IP — the default proxy_pass resolves once at
    # worker-startup and caches forever.
    resolver 127.0.0.11 valid=10s ipv6=off;

    gzip on;
    gzip_types text/plain text/css application/json application/javascript application/xml+rss text/javascript image/svg+xml;
    gzip_min_length 1024;

    location = /index.html {
        add_header Cache-Control "no-cache, no-store, must-revalidate";
    }

    location = /config.json {
        add_header Cache-Control "no-cache, no-store, must-revalidate";
    }

    location /assets/ {
        add_header Cache-Control "public, max-age=31536000, immutable";
        try_files $uri =404;
    }

    # SSE endpoint: disable buffering and keep the connection alive long enough
    # for long-running job streams (no request/response buffering, chunked).
    location ~ ^/api/v1/jobs/[^/]+/events$ {
        # Variable in proxy_pass forces per-request resolution via the resolver
        # directive above. Without this, nginx caches the upstream IP forever.
        set $api_upstream "${API_UPSTREAM}";
        # $request_uri is required when proxy_pass uses a variable — nginx
        # otherwise strips the path and forwards to the bare upstream root.
        proxy_pass $api_upstream$request_uri;
        proxy_http_version 1.1;
        proxy_set_header Host $host;
        proxy_set_header X-Real-IP $remote_addr;
        proxy_set_header X-Forwarded-For $proxy_add_x_forwarded_for;
        proxy_set_header X-Forwarded-Proto $scheme;
        proxy_set_header Connection "";
        proxy_buffering off;
        proxy_cache off;
        proxy_read_timeout 1h;
        proxy_send_timeout 1h;
        chunked_transfer_encoding on;
    }

    # Everything under /api/ → backend. Keeps the browser origin = nginx origin,
    # so no CORS preflight ever fires.
    location /api/ {
        set $api_upstream "${API_UPSTREAM}";
        # $request_uri is required when proxy_pass uses a variable — nginx
        # otherwise strips the path and forwards to the bare upstream root.
        proxy_pass $api_upstream$request_uri;
        proxy_http_version 1.1;
        proxy_set_header Host $host;
        proxy_set_header X-Real-IP $remote_addr;
        proxy_set_header X-Forwarded-For $proxy_add_x_forwarded_for;
        proxy_set_header X-Forwarded-Proto $scheme;
        # OCR splitter + classification can genuinely take a while.
        proxy_read_timeout 300s;
        proxy_send_timeout 300s;
        # Upload: don't buffer the big body, stream straight to the backend.
        proxy_request_buffering off;
    }

    location / {
        try_files $uri $uri/ /index.html;
    }
}
