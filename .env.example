# Empty = same-origin (browser calls /api/... which Vite dev-proxy or nginx
# forwards to the backend). Set to a full URL only if you want to bypass the
# proxy — that requires CORS on the backend.
VITE_API_BASE_URL=

# Backend URL used by Vite dev-server when VITE_API_BASE_URL is empty.
VITE_DEV_PROXY_TARGET=http://localhost:8000

VITE_SSE_ENABLED=true
VITE_SSE_HEARTBEAT_TIMEOUT_MS=45000
VITE_OCR_MAX_FILE_MB=25
VITE_BATCH_SYNC_MAX=5
VITE_DEFAULT_LOCALE=ru
VITE_BUILD_VERSION=dev

# Docker only: backend URL as seen from inside the frontend container.
# Used by nginx to proxy /api → backend. Defaults to http://app:8000 (the
# docker-compose service name for the FastAPI container).
# API_UPSTREAM=http://app:8000
